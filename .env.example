# Local development environment.
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# Database. Port 5433 by default so the container does not collide with a
# native PostgreSQL install already listening on 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=tas
DB_PASSWORD=tas_local_dev_only
DB_NAME=tax_assessment
DB_NAME_TEST=tax_assessment_test

# Redis. Authorisation fails closed without it, so it is a hard dependency.
REDIS_HOST=localhost
REDIS_PORT=6380

# Keycloak (ADR-003: we validate tokens, we never store passwords).
KEYCLOAK_PORT=8085
OIDC_ISSUER_URL=http://localhost:8085/realms/tax-assessment
OIDC_AUDIENCE=tas-api
OIDC_CLIENT_ID=tas-api
OIDC_CLIENT_SECRET=local-dev-only-not-a-real-secret

# Object storage (MinIO locally, S3/Blob in deployed environments).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=tas
STORAGE_SECRET_KEY=tas_local_dev_only
STORAGE_BUCKET=tax-assessment

# Flowable BPMN engine.
BPMN_ENGINE_URL=http://localhost:8080

# Outbound mail. Mailpit captures everything locally; UI on :8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@tax-assessment.local

API_PORT=3000
LOG_LEVEL=debug

# Default jurisdiction when a request carries no explicit one.
DEFAULT_JURISDICTION=GB
DEFAULT_CURRENCY=GBP

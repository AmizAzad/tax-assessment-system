{
  "name": "tax-assessment-system",
  "version": "0.1.0",
  "private": true,
  "description": "Configuration-driven tax assessment platform (IRIS Regtech)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,yml,yaml}\"",
    "typecheck": "tsc --build --verbose",
    "dev:up": "docker compose -f deploy/docker/docker-compose.yml up -d",
    "dev:down": "docker compose -f deploy/docker/docker-compose.yml down",
    "dev:logs": "docker compose -f deploy/docker/docker-compose.yml logs -f",
    "dev:reset": "docker compose -f deploy/docker/docker-compose.yml down -v && npm run dev:up",
    "db:migrate": "sequelize-cli db:migrate --config db/config.js --migrations-path db/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config db/config.js --migrations-path db/migrations",
    "start:api": "npm --workspace @tas/api run start:dev",
    "start:web": "npm --workspace @tas/web run start",
    "start:worker": "npm --workspace @tas/worker run start:dev",
    "security:probe": "node scripts/security/boundary-probe.js",
    "dr:rehearse": "bash scripts/dr/rehearse.sh",
    "load:seed": "node scripts/load/seed-register.js",
    "db:seed": "sequelize-cli db:seed:all --config db/config.js --seeders-path db/seeds",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "web:start": "npm run start --workspace @tas/web",
    "web:build": "npm run build --workspace @tas/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "multer": "^2.3.0",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "overrides": {
    "multer": "$multer",
    "uuid": "^11.1.1"
  }
}

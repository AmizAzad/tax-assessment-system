      "Bash(npx prettier:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose -f deploy/docker/docker-compose.yml ps:*)",
      "Bash(docker compose -f deploy/docker/docker-compose.yml logs:*)",
      "Bash(node -e:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git shortlog:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",

      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -d:*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git branch -D:*)",
      "Bash(git filter-branch:*)",
      "Bash(git reflog delete:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",

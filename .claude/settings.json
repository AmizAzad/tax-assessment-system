      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git cat-file:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git remote:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git restore --staged:*)",
      "Bash(git rm --cached:*)",
      "Bash(git mv:*)",
      "Bash(git commit:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git worktree:*)",

{
  "realm": "tax-assessment",
  "enabled": true,
  "displayName": "Tax Assessment System (local development)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      {
        "name": "TA_TAXPAYER",
        "description": "Taxpayer: own assessments, notices, objections"
      },
      {
        "name": "TA_ASSESSOR",
        "description": "Prepare assessment, record adjustments"
      },
      {
        "name": "TA_SPECIALIST",
        "description": "Technical opinion on referred cases"
      },
      {
        "name": "TA_REVIEWER",
        "description": "Independent review; return for rework"
      },
      {
        "name": "TA_APPROVER_L1",
        "description": "Approve below threshold 1"
      },
      {
        "name": "TA_APPROVER_L2",
        "description": "Approve between thresholds 1 and 2"
      },
      {
        "name": "TA_APPROVER_L3",
        "description": "Approve above threshold 2"
      },
      {
        "name": "TA_SUPERVISOR",
        "description": "Assign, reassign, monitor SLA, escalate"
      },
      {
        "name": "TA_OBJECTION_OFFICER",
        "description": "Handle objections"
      },
      {
        "name": "TA_COMMITTEE_MEMBER",
        "description": "Vote on objection outcomes"
      },
      {
        "name": "TA_APPEALS_OFFICER",
        "description": "Manage appeals"
      },
      {
        "name": "TA_NOTICE_ISSUER",
        "description": "Sign and despatch notices"
      },
      {
        "name": "TA_AUDITOR_READONLY",
        "description": "Read-only oversight and audit access"
      },
      {
        "name": "TA_ADMIN",
        "description": "Configure rule sets, templates, workflows, masters"
      },
      {
        "name": "SYSTEM",
        "description": "The process engine acting as itself. Granted exactly the routes a service task calls."
      },
      {
        "name": "MFA_REQUIRED",
        "description": "Holders must present a second factor. Assigned to every officer account."
      }
    ]
  },
  "clients": [
    {
      "clientId": "tas-api",
      "name": "Tax Assessment API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "secret": "local-dev-only-not-a-real-secret"
    },
    {
      "clientId": "tas-web",
      "name": "Tax Assessment SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tas-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tas-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tas-bpmn",
      "name": "Tax Assessment process engine",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "bpmn_local_dev_only",
      "protocolMappers": [
        {
          "name": "tas-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tas-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"]
    }
  ],

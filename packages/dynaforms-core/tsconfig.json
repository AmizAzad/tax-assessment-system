{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Pinned. Without this every @types package in the monorepo is ambient,
    // and Angular's jasmine types shadow the jest globals these specs use.
    "types": ["node", "jest"],
    "lib": ["ES2023"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
